---
import Layout from '../layouts/Layout.astro';

const sheikh = 'الشيخ حسن أبو طالب';
const whatsappNumber = '+212774399295';
const whatsapp = `https://wa.me/${whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent('السلام عليكم شيخ حسن، أريد استشارة')}`;
const waIcon = '<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.98 1-3.63-.24-.37a9.82 9.82 0 0 1 15.24-12.1 9.75 9.75 0 0 1 2.87 6.94c0 5.42-4.41 9.83-9.83 9.83zm8.36-18.2A11.75 11.75 0 0 0 12.04.1C5.5.1.17 5.42.17 11.96c0 2.09.55 4.13 1.59 5.93L.07 24l6.26-1.64a11.8 11.8 0 0 0 5.7 1.45h.01c6.54 0 11.87-5.32 11.87-11.86 0-3.17-1.23-6.15-3.47-8.39z"/></svg>';

const nav = [
    { href: '#services', label: 'الخدمات' },
    { href: '#about', label: 'عن الشيخ' },
    { href: '#steps', label: 'خطوات التواصل' },
    { href: '#gallery', label: 'معرض الصور' },
    { href: '#faq', label: 'أسئلة شائعة' },
    { href: '#contact', label: 'تواصل معنا' }
];

const serviceGroups = [
    {
        name: 'فك السحر والعلاج الروحاني',
        items: [
            { icon: '✦', title: 'فك السحر', text: 'الكشف عن أعراض السحر بأنواعه، والعمل على فكّه وإبطال أثره بالرقية والأذكار والتحصين.' },
            { icon: '☾', title: 'علاج السحر', text: 'برنامج علاجي متكامل يشمل الرقية الشرعية والتحصين اليومي ومتابعة الحالة حتى الاطمئنان.' },
            { icon: '✺', title: 'فك السحر المأكول والمشروب', text: 'التعامل مع أعراض السحر المأكول والمشروب وتنظيف أثره بالرقية والبرنامج العلاجي.' },
            { icon: '◈', title: 'علاج العين والحسد', text: 'تشخيص أعراض العين والحسد، والرقية لرفع أثرها عن النفس والبيت والرزق.' },
            { icon: '✶', title: 'علاج المس الروحاني', text: 'رقية ومتابعة لحالات المس وما يصاحبها من أعراض وضيق وتعب روحاني.' },
            { icon: '☽', title: 'الكشف الروحاني', text: 'جلسة لفهم الحالة وأعراضها وتحديد طبيعتها قبل البدء بأي علاج.' },
            { icon: '✧', title: 'الرقية الشرعية', text: 'جلسات رقية بالقرآن الكريم والأدعية المأثورة، حضوريًا أو عن بُعد.' }
        ]
    },
    {
        name: 'المحبة والعلاقات',
        items: [
            { icon: '♥', title: 'جلب الحبيب', text: 'إصلاح ما انقطع بين القلوب، وتقريب المودة والمحبة بين المتحابين.' },
            { icon: '❤', title: 'المحبة والقبول', text: 'تقوية المحبة والقبول بين الناس، وكسب الود في الأسرة والعمل.' },
            { icon: '❦', title: 'رد الحبيب الغائب', text: 'المساعدة في عودة الحبيب الغائب أو المبتعد وإزالة أسباب الجفاء.' },
            { icon: '✿', title: 'إزالة الكره والنفور', text: 'علاج أسباب الكره والنفور المفاجئ بين المحبين أو الأقارب.' }
        ]
    },
    {
        name: 'الزواج والأسرة',
        items: [
            { icon: '❖', title: 'رد المطلقة', text: 'المساعدة في لمّ شمل الأسرة، وإزالة أسباب الخلاف، وعودة الوئام بين الزوجين.' },
            { icon: '⚭', title: 'رد الزوج الغائب', text: 'السعي في عودة الزوج الغائب أو الهاجر إلى بيته وأسرته.' },
            { icon: '❀', title: 'إصلاح المشاكل الزوجية', text: 'حل الخلافات المتكررة بين الزوجين، وإعادة المودة والسكينة إلى البيت.' },
            { icon: '✾', title: 'تيسير الزواج وفك التعطيل', text: 'إزالة العوارض والتعطيل وتأخر الزواج للبنات والشباب بإذن الله.' },
            { icon: '⌂', title: 'حل المشاكل الأسرية', text: 'إصلاح ذات البين بين الأهل والأقارب وإزالة أسباب القطيعة.' }
        ]
    },
    {
        name: 'الرزق والتوفيق والتحصين',
        items: [
            { icon: '✪', title: 'فتح الرزق والتجارة', text: 'إزالة أسباب ضيق الرزق وتعطّل التجارة، وفتح أبواب البركة والتوفيق.' },
            { icon: '★', title: 'التوفيق في الدراسة والعمل', text: 'تيسير الأمور وإزالة العوائق أمام النجاح في الدراسة والعمل.' },
            { icon: '♛', title: 'الهيبة والقبول', text: 'تعزيز الهيبة والقبول والحضور بين الناس وفي مجالات العمل.' },
            { icon: '⛨', title: 'تحصين النفس والبيت', text: 'برنامج تحصين للشخص والأسرة والمنزل من السحر والعين والحسد.' },
            { icon: '☁', title: 'علاج الأرق والكوابيس الروحانية', text: 'علاج الكوابيس المتكررة والضيق الروحاني وقلة النوم المرتبطة بها.' }
        ]
    }
];
const gallery = Array.from({ length: 13 }, (_, i) => `/images/gallery/${String(i + 1).padStart(2, '0')}.webp`);
const videos = ['/videos/video-1.mp4', '/videos/video-2.mp4'];
const services = serviceGroups.flatMap((g) => g.items);

const steps = [
    { n: '١', title: 'تواصل معنا', text: 'املأ النموذج أو راسلنا واذكر حالتك باختصار.' },
    { n: '٢', title: 'تشخيص الحالة', text: 'يستمع الشيخ لتفاصيل حالتك بسرّية تامة ويحدد طبيعتها.' },
    { n: '٣', title: 'خطة العلاج', text: 'تحصل على خطة واضحة تناسب حالتك مع التوجيهات اللازمة.' },
    { n: '٤', title: 'المتابعة', text: 'متابعة مستمرة معك حتى تطمئن على استقرار حالتك.' }
];

const faqs = [
    { q: 'هل التواصل سرّي؟', a: 'نعم، جميع المعلومات والحالات تُعامل بسرّية تامة ولا يُطّلع عليها أحد.' },
    { q: 'هل يمكن العلاج عن بُعد؟', a: 'نعم، يمكن التواصل والمتابعة عن بُعد من أي بلد عبر الهاتف أو الرسائل.' },
    { q: 'كم تستغرق مدة العلاج؟', a: 'تختلف المدة من حالة إلى أخرى حسب طبيعتها، ويتم توضيح ذلك بعد تشخيص الحالة.' },
    { q: 'ما المعلومات التي أحتاج لتقديمها؟', a: 'وصف مختصر للحالة والأعراض، وطريقة التواصل المفضلة لديك. لا نطلب أي معلومات لا تخص الحالة.' }
];
---

<Layout title={`${sheikh} | روحانيات وفك السحر وعلاجه`}>
    <header class="sticky top-0 z-50 border-b border-gold/15 bg-ink/80 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
            <a href="#top" class="flex items-center gap-3 no-underline">
                <img src="/favicon.svg" alt="" class="h-10 w-10" />
                <span class="font-display text-xl font-bold gold-text">{sheikh}</span>
            </a>
            <nav class="hidden gap-7 text-sm md:flex">
                {nav.map((n) => <a href={n.href} class="text-white/75 transition hover:text-gold">{n.label}</a>)}
            </nav>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn !bg-[#25D366] !px-5 !py-2 text-sm !text-white hover:!bg-[#1ebe5b]"><Fragment set:html={waIcon} />واتساب</a>
        </div>
    </header>

    <main id="top">
        <!-- Hero -->
        <section class="pattern relative overflow-hidden">
            <div class="mx-auto max-w-6xl px-5 py-24 text-center sm:py-32">
                <p class="font-display text-2xl text-gold-soft">بسم الله الرحمن الرحيم</p>
                <h1 class="mt-6 font-display text-5xl font-bold leading-tight sm:text-7xl">
                    <span class="gold-text">{sheikh}</span>
                </h1>
                <p class="mt-4 text-xl text-white/80 sm:text-2xl">للروحانيات وفك السحر وعلاجه</p>
                <p class="mx-auto mt-6 max-w-2xl leading-loose text-white/65">
                    خبرة طويلة في الرقية والعلاج الروحاني، فك السحر وعلاجه، جلب الحبيب، رد المطلقة، وعلاج العين والحسد — بسرّية تامة ومتابعة شخصية لكل حالة.
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-4">
                    <a href={whatsapp} target="_blank" rel="noopener" class="btn !bg-[#25D366] !text-white hover:!bg-[#1ebe5b]"><Fragment set:html={waIcon} />تواصل مباشر عبر واتساب</a>
                    <a href="#contact" class="btn">احجز استشارة</a>
                    <a href="#services" class="btn-outline">تعرّف على الخدمات</a>
                </div>
                <div class="mx-auto mt-16 grid max-w-3xl grid-cols-3 gap-4 text-center">
                    <div><p class="font-display text-3xl gold-text">سرّية</p><p class="mt-1 text-sm text-white/55">تامة لكل الحالات</p></div>
                    <div><p class="font-display text-3xl gold-text">متابعة</p><p class="mt-1 text-sm text-white/55">شخصية مستمرة</p></div>
                    <div><p class="font-display text-3xl gold-text">عن بُعد</p><p class="mt-1 text-sm text-white/55">من أي مكان</p></div>
                </div>
            </div>
        </section>

        <!-- Services -->
        <section id="services" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24">
            <div class="text-center">
                <p class="text-sm tracking-widest text-gold">خدماتنا</p>
                <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">كافة خدمات الشيخ الروحاني</h2>
                <p class="mx-auto mt-4 max-w-2xl text-white/60">جميع الخدمات متاحة حضوريًا أو عن بُعد، مع سرّية تامة ومتابعة شخصية لكل حالة.</p>
            </div>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                {serviceGroups.map((g, i) => <a href={`#group-${i}`} class="btn-outline !px-5 !py-2 text-sm no-underline">{g.name}</a>)}
            </div>
            {serviceGroups.map((g, i) => (
                <div id={`group-${i}`} class="mt-16 scroll-mt-28">
                    <h3 class="flex items-center gap-4 font-display text-3xl font-bold text-gold-soft">
                        <span class="h-px flex-1 bg-gold/25"></span>{g.name}<span class="h-px flex-1 bg-gold/25"></span>
                    </h3>
                    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {g.items.map((s) => (
                            <article class="card flex flex-col">
                                <div class="flex h-14 w-14 items-center justify-center rounded-full border border-gold/40 text-2xl text-gold">{s.icon}</div>
                                <h4 class="mt-5 font-display text-2xl font-bold text-gold-soft">{s.title}</h4>
                                <p class="mt-3 grow leading-loose text-white/65">{s.text}</p>
                                <a href={`https://wa.me/${whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(`السلام عليكم شيخ حسن، أريد استشارة بخصوص: ${s.title}`)}`} target="_blank" rel="noopener" class="mt-5 text-sm font-bold text-[#25D366] no-underline">اطلب هذه الخدمة عبر واتساب ←</a>
                            </article>
                        ))}
                    </div>
                </div>
            ))}
        </section>

        <!-- About -->
        <section id="about" class="scroll-mt-24 border-y border-gold/15 bg-deep/60">
            <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-24 md:grid-cols-2">
                <div class="relative aspect-square overflow-hidden rounded-3xl border border-gold/25">
                    <img src="/images/gallery/01.webp" alt={sheikh} class="h-full w-full object-cover" loading="lazy" />
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/70 to-transparent p-6 pt-20 text-center">
                        <p class="font-display text-3xl gold-text">{sheikh}</p>
                    </div>
                </div>
                <div>
                    <p class="text-sm tracking-widest text-gold">عن الشيخ</p>
                    <h2 class="mt-3 font-display text-4xl font-bold">من هو {sheikh}؟</h2>
                    <p class="mt-6 leading-loose text-white/70">
                        {sheikh} مختص في الروحانيات والرقية والعلاج الروحاني، يستقبل الحالات من مختلف البلدان ويتعامل مع كل حالة باهتمام وسرّية، ويحرص على الاستماع الجيد وفهم تفاصيل المشكلة قبل تحديد طريقة العلاج.
                    </p>
                    <ul class="mt-8 space-y-4">
                        {['استماع كامل لتفاصيل حالتك دون أحكام', 'خطة علاج واضحة ومتابعة حتى الاطمئنان', 'الحفاظ التام على خصوصيتك وأسرارك', 'إمكانية التواصل والعلاج عن بُعد'].map((t) => (
                            <li class="flex items-start gap-3"><span class="mt-1 text-gold">✦</span><span class="text-white/80">{t}</span></li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>

        <!-- Steps -->
        <section id="steps" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24">
            <div class="text-center">
                <p class="text-sm tracking-widest text-gold">كيف نبدأ</p>
                <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">خطوات التواصل والعلاج</h2>
            </div>
            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {steps.map((s) => (
                    <div class="card text-center">
                        <p class="font-display text-5xl gold-text">{s.n}</p>
                        <h3 class="mt-4 text-xl font-bold text-gold-soft">{s.title}</h3>
                        <p class="mt-2 text-sm leading-loose text-white/60">{s.text}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- Gallery -->
        <section id="gallery" class="scroll-mt-24 border-t border-gold/15 bg-deep/60">
            <div class="mx-auto max-w-6xl px-5 py-24">
                <div class="text-center">
                    <p class="text-sm tracking-widest text-gold">معرض الصور</p>
                    <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">من أعمال الشيخ</h2>
                </div>
                <div class="mt-14 columns-2 gap-4 sm:columns-3 lg:columns-4 [&>*]:mb-4">
                    {gallery.map((src, i) => (
                        <button type="button" data-lightbox={src} class="block w-full overflow-hidden rounded-2xl border border-gold/20 transition hover:border-gold/60">
                            <img src={src} alt={`صورة ${i + 1} – ${sheikh}`} loading="lazy" class="w-full transition duration-500 hover:scale-105" />
                        </button>
                    ))}
                </div>
                <h3 class="mt-20 text-center font-display text-3xl font-bold text-gold-soft">فيديوهات</h3>
                <div class="mx-auto mt-8 grid max-w-3xl gap-6 sm:grid-cols-2">
                    {videos.map((v) => (
                        <video src={v} controls preload="metadata" playsinline class="w-full rounded-2xl border border-gold/25 bg-black"></video>
                    ))}
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section id="faq" class="scroll-mt-24 border-y border-gold/15 bg-deep/60">
            <div class="mx-auto max-w-3xl px-5 py-24">
                <h2 class="text-center font-display text-4xl font-bold">أسئلة شائعة</h2>
                <div class="mt-12 space-y-4">
                    {faqs.map((f) => (
                        <details class="group rounded-2xl border border-gold/20 bg-ink/50 p-6 open:border-gold/50">
                            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-bold text-gold-soft">
                                {f.q}
                                <span class="text-gold transition group-open:rotate-45">+</span>
                            </summary>
                            <p class="mt-4 leading-loose text-white/65">{f.a}</p>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="pattern scroll-mt-24">
            <div class="mx-auto max-w-2xl px-5 py-24">
                <div class="text-center">
                    <p class="text-sm tracking-widest text-gold">تواصل معنا</p>
                    <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">احجز استشارتك</h2>
                    <p class="mt-4 text-white/65">تواصل مباشرة مع الشيخ عبر واتساب، أو اكتب حالتك في النموذج وسيتواصل معك في أقرب وقت. جميع البيانات سرّية.</p>
                    <a href={whatsapp} target="_blank" rel="noopener" class="btn mt-8 !bg-[#25D366] !text-white hover:!bg-[#1ebe5b]"><Fragment set:html={waIcon} />واتساب: <span dir="ltr">{whatsappNumber}</span></a>
                    <p class="mt-6 text-sm text-white/45">أو عبر النموذج</p>
                </div>

                <form id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="card mt-10 space-y-5 hover:!translate-y-0">
                    <input type="hidden" name="form-name" value="contact" />
                    <p class="hidden"><label>لا تملأ هذا الحقل: <input name="bot-field" /></label></p>
                    <div class="grid gap-5 sm:grid-cols-2">
                        <label class="block">
                            <span class="mb-2 block text-sm text-gold-soft">الاسم</span>
                            <input name="name" required class="field" placeholder="اسمك" />
                        </label>
                        <label class="block">
                            <span class="mb-2 block text-sm text-gold-soft">رقم الهاتف / واتساب</span>
                            <input name="phone" type="tel" dir="ltr" required class="field text-right" placeholder="+966 5x xxx xxxx" />
                        </label>
                    </div>
                    <label class="block">
                        <span class="mb-2 block text-sm text-gold-soft">نوع الحالة</span>
                        <select name="service" class="field">
                            {serviceGroups.map((g) => <optgroup label={g.name}>{g.items.map((s) => <option value={s.title}>{s.title}</option>)}</optgroup>)}
                            <option value="أخرى">أخرى</option>
                        </select>
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm text-gold-soft">وصف الحالة</span>
                        <textarea name="message" rows="5" required class="field" placeholder="اكتب تفاصيل حالتك باختصار..."></textarea>
                    </label>
                    <button type="submit" class="btn w-full">إرسال الطلب</button>
                    <p id="form-status" class="hidden text-center font-bold" role="status"></p>
                </form>
            </div>
        </section>
    </main>

    <footer class="border-t border-gold/15 bg-ink">
        <div class="mx-auto max-w-6xl px-5 py-10 text-center text-sm text-white/50">
            <p class="font-display text-xl gold-text">{sheikh}</p>
            <p class="mt-3">للروحانيات وفك السحر وعلاجه — جلب الحبيب — رد المطلقة</p>
            <p class="mx-auto mt-4 max-w-2xl text-xs leading-relaxed text-white/35">
                الخدمات المقدّمة روحانية واستشارية ولا تُغني عن الاستشارة الطبية أو النفسية المتخصصة عند الحاجة.
            </p>
            <p class="mt-3"><a href={whatsapp} target="_blank" rel="noopener" class="text-gold no-underline">واتساب: <span dir="ltr">{whatsappNumber}</span></a></p>
            <p class="mt-4">© {new Date().getFullYear()} جميع الحقوق محفوظة</p>
        </div>
    </footer>

    <a href={whatsapp} target="_blank" rel="noopener" aria-label="تواصل عبر واتساب" class="fixed bottom-5 left-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/40 transition hover:scale-110 [&_svg]:h-7 [&_svg]:w-7">
        <span class="absolute inset-0 animate-ping rounded-full bg-[#25D366] opacity-30"></span>
        <Fragment set:html={waIcon} />
    </a>

    <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 p-4">
        <button type="button" id="lightbox-close" aria-label="إغلاق" class="absolute top-4 right-4 text-4xl text-white">×</button>
        <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full rounded-xl" />
    </div>

    <script>
        const lb = document.getElementById('lightbox')!;
        const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
        const closeLb = () => { lb.classList.add('hidden'); lb.classList.remove('flex'); };
        document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) =>
            el.addEventListener('click', () => { lbImg.src = el.dataset.lightbox!; lb.classList.remove('hidden'); lb.classList.add('flex'); })
        );
        lb.addEventListener('click', (e) => { if (e.target !== lbImg) closeLb(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const status = document.getElementById('form-status')!;
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button')!;
            btn.disabled = true;
            btn.textContent = 'جارٍ الإرسال...';
            try {
                const res = await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(new FormData(form) as any).toString()
                });
                if (!res.ok) throw new Error();
                form.reset();
                status.textContent = 'تم إرسال طلبك بنجاح، سيتواصل معك الشيخ قريبًا بإذن الله.';
                status.className = 'text-center font-bold text-gold';
            } catch {
                status.textContent = 'حدث خطأ أثناء الإرسال، يرجى المحاولة مرة أخرى.';
                status.className = 'text-center font-bold text-red-400';
            } finally {
                btn.disabled = false;
                btn.textContent = 'إرسال الطلب';
            }
        });
    </script>
</Layout>
